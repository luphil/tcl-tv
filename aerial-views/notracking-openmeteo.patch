@@ -0,0 +1,155 @@
+package com.neilturner.aerialviews.services.wallpaper
+
+import android.app.AlarmManager
+import android.app.PendingIntent
+import android.app.WallpaperManager
+import android.content.BroadcastReceiver
+import android.content.Context
+import android.content.Intent
+import android.graphics.Bitmap
+import android.graphics.BitmapFactory
+import android.os.SystemClock
+import androidx.core.content.edit
+import timber.log.Timber
+import java.io.File
+import kotlin.concurrent.thread
+import kotlin.math.max
+import kotlin.math.roundToInt
+
+/**
+ * Rotates the Android system wallpaper through the photos in a folder, so launchers
+ * that show the system wallpaper (e.g. Projectivy's "Default wallpaper") get them too.
+ *
+ * Driven by broadcasts (from adb or the alarm it schedules itself):
+ *   ROTATE_WALLPAPER  extras: folder (String), interval_minutes (Int) — set next photo, keep rotating
+ *   STOP_WALLPAPER    stop rotating (current wallpaper stays)
+ * Settings persist, and rotation resumes after a reboot.
+ */
+class WallpaperRotatorReceiver : BroadcastReceiver() {
+    override fun onReceive(
+        context: Context,
+        intent: Intent,
+    ) {
+        val prefs = context.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+        when (intent.action) {
+            ACTION_STOP -> {
+                prefs.edit { putBoolean(KEY_ENABLED, false) }
+                alarmManager(context).cancel(rotateIntent(context))
+                Timber.i("Wallpaper rotation stopped")
+                return
+            }
+
+            ACTION_ROTATE -> {
+                prefs.edit {
+                    putBoolean(KEY_ENABLED, true)
+                    intent.getStringExtra(EXTRA_FOLDER)?.let { putString(KEY_FOLDER, it) }
+                    if (intent.hasExtra(EXTRA_INTERVAL)) putInt(KEY_INTERVAL, intent.getIntExtra(EXTRA_INTERVAL, DEFAULT_INTERVAL))
+                }
+            }
+
+            Intent.ACTION_BOOT_COMPLETED, Intent.ACTION_MY_PACKAGE_REPLACED -> {
+                if (!prefs.getBoolean(KEY_ENABLED, false)) return
+            }
+
+            else -> return
+        }
+
+        val pending = goAsync()
+        thread {
+            try {
+                showNextPhoto(context)
+                schedule(context, prefs.getInt(KEY_INTERVAL, DEFAULT_INTERVAL))
+            } catch (ex: Exception) {
+                Timber.e(ex, "Wallpaper rotation failed")
+            } finally {
+                pending.finish()
+            }
+        }
+    }
+
+    private fun showNextPhoto(context: Context) {
+        val prefs = context.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+        val folder = File(prefs.getString(KEY_FOLDER, DEFAULT_FOLDER)!!)
+        val photos =
+            folder
+                .walkTopDown()
+                .filter { it.isFile && it.extension.lowercase() in PHOTO_EXTENSIONS }
+                .sortedBy { it.name.lowercase() }
+                .toList()
+        if (photos.isEmpty()) {
+            Timber.w("No photos found in $folder")
+            return
+        }
+
+        val index = prefs.getInt(KEY_INDEX, -1).plus(1).mod(photos.size)
+        val bitmap = decodeCropped(photos[index], TARGET_WIDTH, TARGET_HEIGHT) ?: return
+        WallpaperManager.getInstance(context).setBitmap(bitmap)
+        bitmap.recycle()
+        prefs.edit { putInt(KEY_INDEX, index) }
+        Timber.i("Wallpaper set to ${photos[index].name} (${index + 1}/${photos.size})")
+    }
+
+    // Downsample while decoding (the TV has little RAM), then centre-crop to the screen's shape
+    private fun decodeCropped(
+        file: File,
+        width: Int,
+        height: Int,
+    ): Bitmap? {
+        val bounds = BitmapFactory.Options().apply { inJustDecodeBounds = true }
+        BitmapFactory.decodeFile(file.path, bounds)
+        if (bounds.outWidth <= 0 || bounds.outHeight <= 0) return null
+
+        var sample = 1
+        while (bounds.outWidth / (sample * 2) >= width && bounds.outHeight / (sample * 2) >= height) sample *= 2
+        val source = BitmapFactory.decodeFile(file.path, BitmapFactory.Options().apply { inSampleSize = sample }) ?: return null
+
+        val scale = max(width.toFloat() / source.width, height.toFloat() / source.height)
+        val scaled = Bitmap.createScaledBitmap(source, (source.width * scale).roundToInt(), (source.height * scale).roundToInt(), true)
+        if (scaled != source) source.recycle()
+        val cropped = Bitmap.createBitmap(scaled, (scaled.width - width) / 2, (scaled.height - height) / 2, width, height)
+        if (cropped != scaled) scaled.recycle()
+        return cropped
+    }
+
+    private fun schedule(
+        context: Context,
+        intervalMinutes: Int,
+    ) {
+        val interval = intervalMinutes.coerceAtLeast(1) * 60_000L
+        alarmManager(context).setInexactRepeating(
+            AlarmManager.ELAPSED_REALTIME,
+            SystemClock.elapsedRealtime() + interval,
+            interval,
+            rotateIntent(context),
+        )
+    }
+
+    private fun alarmManager(context: Context) = context.getSystemService(AlarmManager::class.java)
+
+    private fun rotateIntent(context: Context): PendingIntent =
+        PendingIntent.getBroadcast(
+            context,
+            0,
+            Intent(context, WallpaperRotatorReceiver::class.java).setAction(ACTION_ROTATE),
+            PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE,
+        )
+
+    companion object {
+        const val ACTION_ROTATE = "com.neilturner.aerialviews.ROTATE_WALLPAPER"
+        const val ACTION_STOP = "com.neilturner.aerialviews.STOP_WALLPAPER"
+        const val EXTRA_FOLDER = "folder"
+        const val EXTRA_INTERVAL = "interval_minutes"
+
+        private const val PREFS = "wallpaper_rotator"
+        private const val KEY_ENABLED = "enabled"
+        private const val KEY_FOLDER = "folder"
+        private const val KEY_INTERVAL = "interval_minutes"
+        private const val KEY_INDEX = "index"
+
+        private const val DEFAULT_FOLDER = "/storage/emulated/0/Pictures/Wallpapers"
+        private const val DEFAULT_INTERVAL = 30
+        private const val TARGET_WIDTH = 1920
+        private const val TARGET_HEIGHT = 1080
+        private val PHOTO_EXTENSIONS = setOf("jpg", "jpeg", "png", "webp", "heic", "avif")
+    }
+}

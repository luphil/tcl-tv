+package com.neilturner.aerialviews.services.weather
+
+import android.content.Context
+import com.neilturner.aerialviews.data.network.JsonHelper.buildSerializer
+import com.neilturner.aerialviews.services.weather.NetworkHelpers.buildOkHttpClient
+import kotlinx.serialization.SerialName
+import kotlinx.serialization.Serializable
+import okhttp3.ResponseBody.Companion.toResponseBody
+import retrofit2.Response
+import retrofit2.Retrofit
+import retrofit2.http.GET
+import retrofit2.http.Query
+import java.time.LocalDate
+import java.time.ZoneOffset
+import kotlin.math.roundToInt
+
+/**
+ * Keyless weather provider backed by Open-Meteo (https://open-meteo.com).
+ * Implements OpenWeatherApi so the rest of the app is unchanged: responses are
+ * translated into OpenWeather-shaped models, with WMO weather codes mapped to
+ * OpenWeather condition codes and icon names.
+ */
+class OpenMeteoApi(
+    context: Context,
+) : OpenWeatherApi {
+    private val forecastClient = buildClient(context, "https://api.open-meteo.com/")
+    private val geocodingClient = buildClient(context, "https://geocoding-api.open-meteo.com/")
+
+    override suspend fun getCurrentWeather(
+        lat: Double,
+        lon: Double,
+        apiKey: String,
+        units: String,
+        language: String,
+    ): Response<CurrentWeatherResponse> {
+        val response = fetch(lat, lon, units)
+        val body = response.body() ?: return failure(response)
+        val current = body.current
+        return Response.success(
+            CurrentWeatherResponse(
+                weather = listOf(toWeather(current.weatherCode, current.isDay == 1)),
+                main =
+                    MainWeatherData(
+                        temp = current.temperature,
+                        feelsLike = current.apparentTemperature,
+                        tempMin = body.daily.temperatureMin.firstOrNull() ?: current.temperature,
+                        tempMax = body.daily.temperatureMax.firstOrNull() ?: current.temperature,
+                        pressure = current.pressure.roundToInt(),
+                        humidity = current.humidity,
+                    ),
+                wind = Wind(current.windSpeed, current.windDirection.roundToInt()),
+                name = "",
+            ),
+        )
+    }
+
+    override suspend fun getForecast(
+        lat: Double,
+        lon: Double,
+        apiKey: String,
+        units: String,
+        language: String,
+    ): Response<FiveDayForecastResponse> {
+        val response = fetch(lat, lon, units)
+        val body = response.body() ?: return failure(response)
+        val offset = ZoneOffset.ofTotalSeconds(body.utcOffsetSeconds)
+        // One item per day at local midday; WeatherService groups items by local date
+        val items =
+            body.daily.time.indices.map { i ->
+                val date = LocalDate.parse(body.daily.time[i])
+                val max = body.daily.temperatureMax[i]
+                val min = body.daily.temperatureMin[i]
+                ForecastItem(
+                    dt = date.atTime(12, 0).toEpochSecond(offset),
+                    main = MainWeatherData(max, max, min, max, 0, 0),
+                    weather = listOf(toWeather(body.daily.weatherCode[i], isDay = true)),
+                    wind = Wind(0.0, 0),
+                    dtTxt = "${body.daily.time[i]} 12:00:00",
+                )
+            }
+        return Response.success(FiveDayForecastResponse(items, City("", "", body.utcOffsetSeconds)))
+    }
+
+    override suspend fun getLocationByName(
+        locationName: String,
+        limit: Int,
+        apiKey: String,
+        language: String,
+    ): Response<List<LocationResponse>> {
+        val response = geocodingClient.search(locationName, limit, language)
+        val body = response.body() ?: return failure(response)
+        return Response.success(
+            body.results.map {
+                LocationResponse(it.name, it.latitude, it.longitude, it.countryCode ?: it.country.orEmpty(), it.admin1)
+            },
+        )
+    }
+
+    // Open-Meteo has no reverse geocoding, so echo the coordinates back as the location
+    override suspend fun getLocationByCoordinates(
+        lat: Double,
+        lon: Double,
+        limit: Int,
+        apiKey: String,
+        language: String,
+    ): Response<List<LocationResponse>> = Response.success(listOf(LocationResponse("%.4f, %.4f".format(lat, lon), lat, lon, "")))
+
+    private suspend fun fetch(
+        lat: Double,
+        lon: Double,
+        units: String,
+    ): Response<OpenMeteoForecast> {
+        val imperial = units == "imperial"
+        return forecastClient.forecast(
+            lat = lat,
+            lon = lon,
+            temperatureUnit = if (imperial) "fahrenheit" else "celsius",
+            windSpeedUnit = if (imperial) "mph" else "kmh",
+        )
+    }
+
+    private fun toWeather(
+        wmoCode: Int,
+        isDay: Boolean,
+    ): Weather {
+        val (id, main, description) =
+            when (wmoCode) {
+                0 -> Triple(800, "Clear", "clear sky")
+                1 -> Triple(801, "Clouds", "mainly clear")
+                2 -> Triple(802, "Clouds", "partly cloudy")
+                3 -> Triple(804, "Clouds", "overcast")
+                45, 48 -> Triple(741, "Fog", "fog")
+                51 -> Triple(300, "Drizzle", "light drizzle")
+                53 -> Triple(301, "Drizzle", "drizzle")
+                55 -> Triple(302, "Drizzle", "heavy drizzle")
+                56, 57, 66, 67 -> Triple(511, "Rain", "freezing rain")
+                61 -> Triple(500, "Rain", "light rain")
+                63 -> Triple(501, "Rain", "moderate rain")
+                65 -> Triple(502, "Rain", "heavy rain")
+                71 -> Triple(600, "Snow", "light snow")
+                73 -> Triple(601, "Snow", "snow")
+                75 -> Triple(602, "Snow", "heavy snow")
+                77 -> Triple(600, "Snow", "snow grains")
+                80 -> Triple(520, "Rain", "light showers")
+                81 -> Triple(521, "Rain", "showers")
+                82 -> Triple(522, "Rain", "heavy showers")
+                85 -> Triple(620, "Snow", "light snow showers")
+                86 -> Triple(621, "Snow", "snow showers")
+                95 -> Triple(211, "Thunderstorm", "thunderstorm")
+                96, 99 -> Triple(202, "Thunderstorm", "thunderstorm with hail")
+                else -> Triple(800, "Clear", "clear sky")
+            }
+        val iconNumber =
+            when {
+                id == 800 -> "01"
+                id == 801 -> "02"
+                id == 802 -> "03"
+                id in 803..804 -> "04"
+                id in 200..299 -> "11"
+                id in 300..399 || id in 520..531 -> "09"
+                id == 511 || id in 600..699 -> "13"
+                id in 500..504 -> "10"
+                id in 700..799 -> "50"
+                else -> "01"
+            }
+        return Weather(id, main, description, iconNumber + if (isDay) "d" else "n")
+    }
+
+    private fun buildClient(
+        context: Context,
+        baseUrl: String,
+    ): OpenMeteoService =
+        Retrofit
+            .Builder()
+            .baseUrl(baseUrl)
+            .client(buildOkHttpClient(context))
+            .addConverterFactory(buildSerializer())
+            .build()
+            .create(OpenMeteoService::class.java)
+
+    private fun <T> failure(response: Response<*>): Response<T> =
+        Response.error(
+            if (response.isSuccessful) 502 else response.code(),
+            response.errorBody() ?: "".toResponseBody(null),
+        )
+}
+
+interface OpenMeteoService {
+    @GET("v1/forecast")
+    suspend fun forecast(
+        @Query("latitude") lat: Double,
+        @Query("longitude") lon: Double,
+        @Query("temperature_unit") temperatureUnit: String,
+        @Query("wind_speed_unit") windSpeedUnit: String,
+        @Query("current") current: String =
+            "temperature_2m,apparent_temperature,relative_humidity_2m,surface_pressure,weather_code,is_day,wind_speed_10m,wind_direction_10m",
+        @Query("daily") daily: String = "weather_code,temperature_2m_max,temperature_2m_min",
+        @Query("timezone") timezone: String = "auto",
+        @Query("forecast_days") forecastDays: Int = 7,
+    ): Response<OpenMeteoForecast>
+
+    @GET("v1/search")
+    suspend fun search(
+        @Query("name") name: String,
+        @Query("count") count: Int,
+        @Query("language") language: String,
+    ): Response<OpenMeteoGeocoding>
+}
+
+@Serializable
+data class OpenMeteoForecast(
+    @SerialName("utc_offset_seconds") val utcOffsetSeconds: Int = 0,
+    val current: OpenMeteoCurrent,
+    val daily: OpenMeteoDaily,
+)
+
+@Serializable
+data class OpenMeteoCurrent(
+    @SerialName("temperature_2m") val temperature: Double,
+    @SerialName("apparent_temperature") val apparentTemperature: Double,
+    @SerialName("relative_humidity_2m") val humidity: Int,
+    @SerialName("surface_pressure") val pressure: Double,
+    @SerialName("weather_code") val weatherCode: Int,
+    @SerialName("is_day") val isDay: Int,
+    @SerialName("wind_speed_10m") val windSpeed: Double,
+    @SerialName("wind_direction_10m") val windDirection: Double,
+)
+
+@Serializable
+data class OpenMeteoDaily(
+    val time: List<String>,
+    @SerialName("weather_code") val weatherCode: List<Int>,
+    @SerialName("temperature_2m_max") val temperatureMax: List<Double>,
+    @SerialName("temperature_2m_min") val temperatureMin: List<Double>,
+)
+
+@Serializable
+data class OpenMeteoGeocoding(
+    val results: List<OpenMeteoPlace> = emptyList(),
+)
+
+@Serializable
+data class OpenMeteoPlace(
+    val name: String,
+    val latitude: Double,
+    val longitude: Double,
+    val country: String? = null,
+    @SerialName("country_code") val countryCode: String? = null,
+    val admin1: String? = null,
+)
